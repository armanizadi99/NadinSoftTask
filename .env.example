# Copy this file to .env and adjust the values before running:
#   cp .env.example .env
#
# Docker Compose reads .env automatically from the directory that contains
# docker-compose.yml. Every value below already has a working default in
# docker-compose.yml, so .env is optional for local development.

# SQL Server "sa" password. Must satisfy SQL Server's password policy.
# Used by both the sqlserver container and the API connection string.
MSSQL_SA_PASSWORD=NadinSoft!Passw0rd

# HMAC-SHA256 signing key for JWT access tokens.
# Must be at least 32 bytes. Passed to the API as Jwt__SigningKey.
JWT_SIGNING_KEY=dev-only-signing-key-change-me-32-bytes!

# Host port for the API container (container port is 8080).
API_PORT=8080

# Host port for SQL Server, bound to 127.0.0.1 only.
# 1434 is used by default to avoid clashing with a local SQL Server on 1433.
SQLSERVER_PORT=1434

# ---------------------------------------------------------------------------
# These are development-only defaults. Override them for any shared or
# network-reachable environment and never commit real secrets.
# ---------------------------------------------------------------------------
